# CONFIGURAÇÕES DO SERVIDOR
NODE_ENV=production
PORT=8080

# CONFIGURAÇÕES DO BANCO DE DADOS
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cami3d?retryWrites=true&w=majority

# CONFIGURAÇÕES DE AUTENTICAÇÃO
JWT_SECRET=sua_chave_secreta_muito_forte_aqui_com_pelo_menos_32_caracteres

# CONFIGURAÇÕES DE EMAIL (PRODUÇÃO - Use um provedor confiável como SendGrid, AWS SES, etc.)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=sua_api_key_do_sendgrid
MAIL_FROM=noreply@seudominio.com

# URLs DE PRODUÇÃO
FRONTEND_URL=https://seudominio.com
PRODUCTION_URL=https://api.seudominio.com
PRODUCTION_FRONTEND_URL=https://seudominio.com

# CONFIGURAÇÕES DE RATE LIMITING
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
